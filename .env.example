# Booking tool embed URL (e.g. a Cal.com, TidyCal or Momence embed link).
# Leave empty to show the booking placeholder on /book.
PUBLIC_BOOKING_EMBED_URL=

# Form service endpoint for /contact (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty and the form shows "not connected yet" plus an email link.
PUBLIC_FORM_ENDPOINT=
