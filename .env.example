# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.

# Postgres connection (the Vercel Neon integration sets DATABASE_URL / POSTGRES_URL for you).
DATABASE_URL=

# Stripe — use TEST keys (sk_test_…) until a test booking works end to end.
STRIPE_SECRET_KEY=
# Not needed for hosted Checkout; keep for reference if you add Stripe.js later.
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook pointing at https://www.moonandsilks.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Card surcharge = Stripe's fee passed on AT COST. Set these to your actual Stripe rate and never higher
# (Australian law caps surcharges at the cost of acceptance). Defaults: 1.7% + $0.30.
STRIPE_FEE_PERCENT=1.7
STRIPE_FEE_FIXED=0.30

# Admin login at /admin. Use a long, unique password.
ADMIN_PASSWORD=
# Random secret of at least 32 characters for signing the admin session cookie
# (e.g. run: openssl rand -base64 48).
AUTH_SECRET=

# Optional confirmation emails via Resend. Leave blank to skip email.
RESEND_API_KEY=
EMAIL_FROM=

# Contact form endpoint (Formspree, Tally, Getform). Leave blank to show "not connected yet".
PUBLIC_FORM_ENDPOINT=
