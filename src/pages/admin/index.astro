---
import Admin from '../../layouts/Admin.astro';
import { sessionLabel, sessionsOverview } from '../../lib/admin';
import { releaseExpiredHolds } from '../../lib/booking';
import { expireCheckoutSessions } from '../../lib/stripe';
export const prerender = false;

await expireCheckoutSessions(await releaseExpiredHolds());
const sessions = await sessionsOverview();
---

<Admin title="Sessions">
  <h1>Sessions</h1>
  <p>
    <a class="btn btn--ghost btn-small" href="/admin/export.csv" download>Export all rosters (CSV) — sensitive: includes health notes</a>
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Session</th>
          <th scope="col">Booked</th>
          <th scope="col">Health Flags</th>
        </tr>
      </thead>
      <tbody>
        {
          sessions.map((s) => (
            <tr>
              <td>
                <a href={`/admin/session/${s.id}`}>{sessionLabel(s)}</a>
              </td>
              <td>
                {s.confirmed} / {s.capacity}
                {s.confirmed >= s.capacity && <span class="badge warn">Full</span>}
              </td>
              <td>{s.health > 0 && <span class="flag" role="img" aria-label="Health flag" title="Health flag">✱</span>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Admin>

<style>
  .flag {
    color: #e6b400;
    font-size: 1.3rem;
    font-weight: 700;
  }
</style>
