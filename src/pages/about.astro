---
import Base from '../layouts/Base.astro';

// Photo slot: add the file to public/ and set e.g. { src: '/about.webp', width: 600, height: 750, alt: '…' }.
type Photo = { src: string; width: number; height: number; alt: string };
const photo = null as Photo | null;
---

<Base title="About" description="Meet the instructor behind Moon and Silks Circus Co and find out what aerial silk classes feel like.">
  <section class="section">
    <div class:list={['wrap', { about: photo }]}>
      {
        photo && (
          <figure class="portrait">
            <img class="frame" src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} />
          </figure>
        )
      }
      <div>
        <h1>About</h1>
        <p>
          With 15 years of experience in ballet and dance, my passion for movement, artistry and performance has always been a huge part of who I am. Over time, I transitioned from the world of traditional dance into the exciting world of aerial arts, beginning with aerial silks before expanding my skills to include lyra and flying trapeze. My journey has allowed me to combine my dance foundations with strength, creativity and a love for exploring new ways to move, express and perform in the air.
        </p>
        <p><a class="btn" href="/book">Book a class</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .about {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 3rem;
    }
  }
  .portrait {
    margin: 0;
    padding: 0.5rem;
  }
  .frame {
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 420px;
    height: auto;
    object-fit: cover;
    border-radius: calc(var(--radius) - 4px);
  }
</style>
