---
import Base from '../layouts/Base.astro';
import WaiverText from '../components/WaiverText.astro';
import { getSchedule, releaseExpiredHolds } from '../lib/booking';
import { formatDay, formatDayShort, formatTime, perthDate } from '../lib/dates';
import { env } from '../lib/env';
import { formatAud } from '../lib/money';
import { expireCheckoutSessions, stripeEnabled } from '../lib/stripe';
import { ACKNOWLEDGEMENTS } from '../lib/validate';
import { waiverSigningText } from '../lib/waiver-render';
import { WAIVER_VERSION } from '../lib/waiver-text';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

let schedule: Awaited<ReturnType<typeof getSchedule>> = [];
let loadError = false;
try {
  await expireCheckoutSessions(await releaseExpiredHolds());
  schedule = await getSchedule();
} catch (e) {
  loadError = true;
  console.error('Schedule failed to load:', e instanceof Error ? e.message : 'unknown');
}

const now = new Date();
const sessions = schedule.map((s) => ({
  id: s.id,
  date: perthDate(s.startsAt),
  label: `${formatDayShort(s.startsAt)} · ${formatTime(s.startsAt)} · ${s.ageGroup}`,
  dayLong: formatDay(s.startsAt),
  ageGroup: s.ageGroup,
  ageMin: s.ageMin,
  ageMax: s.ageMax,
  priceCents: s.priceCents,
  spotsLeft: s.startsAt > now ? s.spotsLeft : 0,
  past: s.startsAt <= now,
}));
const days = [...new Map(schedule.map((s) => [perthDate(s.startsAt), formatDay(s.startsAt)])).entries()];
const config = {
  sessions,
  feePercent: env.feePercent,
  feeFixedCents: env.feeFixedCents,
  cardEnabled: stripeEnabled(),
  waiverVersion: WAIVER_VERSION,
  today: perthDate(now),
};
const signing = waiverSigningText();
const price = schedule[0]?.priceCents ?? 2000;
---

<Base title="Book a class" description="Book aerial and circus classes with Moon and Silks Circus Co at NDHS, Bishop Street, Nannup. A$20 per session, 10 spots per class.">
  <section class="section">
    <div class="wrap">
      <h1>Book a class</h1>
      <p class="lede">Aerial and circus classes at NDHS, Bishop Street, Nannup. {formatAud(price)} per participant per one-hour session, up to 10 people per class.</p>

      {
        loadError ? (
          <p class="notice-box" role="alert">
            Bookings are not available right now. Please try again soon, or <a href="/contact">get in touch</a>.
          </p>
        ) : (
          <>
            <h2 class="schedule-heading">Schedule</h2>
            <div class="schedule">
              {days.map(([date, label]) => (
                <section class="day" aria-label={label}>
                  <h3>{label}</h3>
                  <ul>
                    {sessions
                      .filter((s) => s.date === date)
                      .map((s) => (
                        <li class:list={['slot', { full: s.spotsLeft === 0 }]}>
                          <span class="slot-time">{s.label.split(' · ')[1]}</span>
                          <span class="slot-age">{s.ageGroup}</span>
                          <span class="slot-price">{formatAud(s.priceCents)}</span>
                          <span class="slot-left" data-left-for={s.id}>
                            {s.past ? 'Finished' : s.spotsLeft === 0 ? 'Sold out' : `${s.spotsLeft} ${s.spotsLeft === 1 ? 'spot' : 'spots'} left`}
                          </span>
                        </li>
                      ))}
                  </ul>
                </section>
              ))}
            </div>

            <noscript>
              <p class="notice-box">Online booking needs JavaScript. Please turn it on, or <a href="/contact">contact us</a> to book.</p>
            </noscript>

            <form id="booking" class="booking" novalidate hidden>
              <p class="steps" aria-live="polite">
                Step <span id="step-num">1</span> of 3
              </p>
              <div id="error-summary" class="error-summary" role="alert" tabindex="-1" hidden />

              {/* Step 1: who and which classes */}
              <section class="step" data-step="1" aria-labelledby="h-step-1">
                <h2 id="h-step-1" tabindex="-1">Who’s coming?</h2>
                <p class="muted">Add each participant and tick their classes. You can book several people and several Saturdays at once.</p>
                <div id="participants" />
                <button type="button" class="btn btn--ghost" id="add-participant">Add another participant</button>
                <div class="cart" id="cart-summary" aria-live="polite" />
                <div class="nav-row">
                  <button type="button" class="btn" data-next="2">Continue to waivers</button>
                </div>
              </section>

              {/* Step 2: waivers */}
              <section class="step" data-step="2" aria-labelledby="h-step-2" hidden>
                <h2 id="h-step-2" tabindex="-1">Waivers</h2>
                <p class="muted">Each participant needs their own signed waiver. Please read it in full.</p>
                <WaiverText />
                <div id="waivers" />
                <div class="nav-row">
                  <button type="button" class="btn btn--ghost" data-prev="1">Back</button>
                  <button type="button" class="btn" data-next="3">Continue to payment</button>
                </div>
              </section>

              {/* Step 3: booker + payment */}
              <section class="step" data-step="3" aria-labelledby="h-step-3" hidden>
                <h2 id="h-step-3" tabindex="-1">Payment</h2>
                <fieldset class="group">
                  <legend>Your contact details</legend>
                  <p class="muted small">We’ll use these for this booking. If you add an email service later, confirmations go here.</p>
                  <div class="field">
                    <label for="booker-name">Your name</label>
                    <input id="booker-name" data-key="booker.name" autocomplete="name" required />
                    <p class="error" id="err-booker.name" hidden />
                  </div>
                  <div class="field">
                    <label for="booker-email">Email</label>
                    <input id="booker-email" data-key="booker.email" type="email" autocomplete="email" required />
                    <p class="error" id="err-booker.email" hidden />
                  </div>
                  <div class="field">
                    <label for="booker-phone">Phone</label>
                    <input id="booker-phone" data-key="booker.phone" type="tel" autocomplete="tel" required />
                    <p class="error" id="err-booker.phone" hidden />
                  </div>
                </fieldset>

                <fieldset class="group">
                  <legend>How would you like to pay?</legend>
                  <div class="choice">
                    <input type="radio" name="payment" id="pay-card" value="card" disabled={!config.cardEnabled} />
                    <label for="pay-card">
                      Pay by card now{!config.cardEnabled && <span class="muted"> (not available yet)</span>}
                      <span class="hint">Secure Stripe checkout. A small card surcharge covers the processing fee at cost.</span>
                    </label>
                  </div>
                  <div class="choice">
                    <input type="radio" name="payment" id="pay-cash" value="cash" />
                    <label for="pay-cash">
                      Pay cash at class
                      <span class="hint">Your spots are booked now. Bring the amount due to class.</span>
                    </label>
                  </div>
                  <p class="error" id="err-payment" hidden />
                </fieldset>

                <div class="cart" id="pay-summary" aria-live="polite" />
                <div class="nav-row">
                  <button type="button" class="btn btn--ghost" data-prev="2">Back</button>
                  <button type="submit" class="btn" id="submit-btn">Book</button>
                </div>
              </section>
            </form>
          </>
        )
      }

      <p class="muted after">Questions before you book? <a href="/contact">Get in touch</a>.</p>
    </div>
  </section>

  {/* Templates cloned by the script. `__i` becomes the participant index. */}
  <template id="tpl-participant">
    <fieldset class="participant group" data-index="__i">
      <legend>Participant <span class="pnum"></span></legend>
      <div class="field">
        <label for="p__i-fullName">Full name</label>
        <input id="p__i-fullName" data-key="p__i.fullName" autocomplete="off" required />
        <p class="error" id="err-p__i.fullName" hidden></p>
      </div>
      <div class="field">
        <label for="p__i-dateOfBirth">Date of birth</label>
        <input id="p__i-dateOfBirth" data-key="p__i.dateOfBirth" type="date" required />
        <p class="error" id="err-p__i.dateOfBirth" hidden></p>
      </div>
      <fieldset class="classes">
        <legend>Classes</legend>
        <div class="class-list"></div>
        <p class="error" id="err-p__i.sessions" hidden></p>
      </fieldset>
      <div class="age-warnings" aria-live="polite"></div>
      <button type="button" class="link-btn remove-participant">Remove this participant</button>
    </fieldset>
  </template>

  <template id="tpl-waiver">
    <fieldset class="waiver group" data-index="__i">
      <legend>Waiver for <span class="wname"></span></legend>
      <h3 class="sub">{signing.detailsHeading}</h3>
      <p class="muted small">Full name: <strong class="wname"></strong> · Date of birth: <strong class="wdob"></strong></p>
      <button type="button" class="link-btn copy-details" hidden>Copy phone, email and emergency contact from participant 1</button>
      <div class="field">
        <label for="p__i-phone">Phone</label>
        <input id="p__i-phone" data-key="p__i.phone" type="tel" autocomplete="tel" required />
        <p class="error" id="err-p__i.phone" hidden></p>
      </div>
      <div class="field">
        <label for="p__i-email">Email</label>
        <input id="p__i-email" data-key="p__i.email" type="email" autocomplete="email" required />
        <p class="error" id="err-p__i.email" hidden></p>
      </div>
      <div class="field">
        <label for="p__i-emergencyName">Emergency contact</label>
        <input id="p__i-emergencyName" data-key="p__i.emergencyName" required />
        <p class="error" id="err-p__i.emergencyName" hidden></p>
      </div>
      <div class="field">
        <label for="p__i-emergencyPhone">Emergency contact phone</label>
        <input id="p__i-emergencyPhone" data-key="p__i.emergencyPhone" type="tel" required />
        <p class="error" id="err-p__i.emergencyPhone" hidden></p>
      </div>
      <div class="field">
        <label for="p__i-healthNotes">Injuries or medical conditions we should know about</label>
        <textarea id="p__i-healthNotes" data-key="p__i.healthNotes" rows="3"></textarea>
        <div class="check">
          <input type="checkbox" id="p__i-healthNone" data-key="p__i.healthNone" />
          <label for="p__i-healthNone">None</label>
        </div>
        <p class="error" id="err-p__i.health" hidden></p>
      </div>

      <fieldset class="acks">
        <legend>Acknowledgement — by signing, I confirm that:</legend>
        {
          ACKNOWLEDGEMENTS.map((a) => (
            <div class="check">
              <input type="checkbox" id={`p__i-ack-${a.key}`} data-ack={a.key} />
              <label for={`p__i-ack-${a.key}`}>{a.label}</label>
            </div>
          ))
        }
        <p class="error" id="err-p__i.acks" hidden></p>
      </fieldset>

      <h3 class="sub">{signing.declarationHeading}</h3>
      <p>{signing.declaration}</p>
      <div class="field">
        <label for="p__i-signature">Participant signature (type full name)</label>
        <input id="p__i-signature" data-key="p__i.signature" class="sig" autocomplete="off" required />
        <p class="hint">Date: signed today when you submit. Your typed name, the time and your IP address are recorded.</p>
        <p class="error" id="err-p__i.signature" hidden></p>
      </div>

      <div class="guardian" hidden>
        <h3 class="sub">{signing.guardianHeading}</h3>
        <p>{signing.guardianStatement}</p>
        <div class="field">
          <label for="p__i-guardianName">Parent/Guardian name</label>
          <input id="p__i-guardianName" data-key="p__i.guardianName" autocomplete="name" />
          <p class="error" id="err-p__i.guardianName" hidden></p>
        </div>
        <div class="field">
          <label for="p__i-guardianRelationship">Relationship to participant</label>
          <input id="p__i-guardianRelationship" data-key="p__i.guardianRelationship" />
          <p class="error" id="err-p__i.guardianRelationship" hidden></p>
        </div>
        <div class="field">
          <label for="p__i-guardianSignature">Parent/Guardian signature (type full name)</label>
          <input id="p__i-guardianSignature" data-key="p__i.guardianSignature" class="sig" autocomplete="off" />
          <p class="error" id="err-p__i.guardianSignature" hidden></p>
        </div>
      </div>
    </fieldset>
  </template>

  <script is:inline id="booking-config" type="application/json" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { initBooking } from '../scripts/booking-client';
  initBooking();
</script>

<style>
  .schedule-heading {
    margin-top: 1.5rem;
  }
  .schedule {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .schedule {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .day {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }
  .day h3 {
    font-size: 1.1rem;
  }
  .day ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .slot {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0 0.5rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .slot-time {
    font-weight: 600;
  }
  .slot-price {
    text-align: right;
  }
  .slot-left {
    grid-column: 2 / 4;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
  .slot.full .slot-left {
    color: var(--error);
    font-weight: 600;
  }
  .booking :global(.group) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem clamp(1rem, 4vw, 1.5rem) 1.25rem;
    margin: 0 0 1.25rem;
    min-width: 0;
  }
  .booking :global(legend) {
    font-weight: 600;
    padding: 0 0.25rem;
  }
  .booking :global(.participant > legend),
  .booking :global(.waiver > legend) {
    font-family: var(--font-head);
    font-size: 1.2rem;
  }
  .booking :global(.field) {
    display: grid;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }
  .booking :global(label) {
    font-weight: 600;
  }
  .booking :global(input:not([type='checkbox']):not([type='radio'])),
  .booking :global(textarea) {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1.5px solid #8f877c;
    border-radius: 8px;
    padding: 0.65rem 0.8rem;
    min-height: 48px;
    width: 100%;
    max-width: 32rem;
  }
  .booking :global(textarea) {
    max-width: none;
  }
  .booking :global([aria-invalid='true']) {
    border-color: var(--error) !important;
  }
  .booking :global(input[type='checkbox']),
  .booking :global(input[type='radio']) {
    width: 22px;
    height: 22px;
    margin: 0.15rem 0 0;
    accent-color: var(--ink-blue);
    flex: none;
  }
  .booking :global(.check),
  .booking :global(.choice) {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    min-height: 44px;
    padding: 0.35rem 0;
  }
  .booking :global(.check label),
  .booking :global(.acks label) {
    font-weight: 400;
  }
  .booking :global(.classes) {
    border: 0;
    padding: 0;
    margin: 0 0 0.5rem;
  }
  .booking :global(.class-list .check.is-disabled label) {
    color: var(--ink-muted);
  }
  .booking :global(.acks) {
    border: 0;
    padding: 0;
    margin: 0.5rem 0 1rem;
  }
  .booking :global(.sub) {
    font-size: 1rem;
    letter-spacing: 0.04em;
    margin-top: 1.25rem;
  }
  .booking :global(.sig) {
    font-family: var(--font-head);
    font-size: 1.15rem;
  }
  .booking :global(.hint),
  .small {
    display: block;
    font-weight: 400;
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .booking :global(.error) {
    color: var(--error);
    margin: 0;
    font-size: 0.95rem;
  }
  .booking :global(.warn) {
    background: var(--pale-gold);
    border-left: 4px solid var(--gold-deep);
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    margin: 0.25rem 0 0.75rem;
  }
  .booking :global(.link-btn) {
    background: none;
    border: 0;
    padding: 0.5rem 0;
    min-height: 44px;
    color: var(--ink-blue);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .booking :global(.cart) {
    background: var(--pale-blue);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin: 1rem 0;
  }
  .booking :global(.cart:empty) {
    display: none;
  }
  .booking :global(.cart ul) {
    margin: 0.25rem 0 0.5rem;
    padding-left: 1.2rem;
  }
  .booking :global(.cart table) {
    border-collapse: collapse;
    width: 100%;
    max-width: 28rem;
  }
  .booking :global(.cart td) {
    padding: 0.2rem 0;
  }
  .booking :global(.cart td:last-child) {
    text-align: right;
  }
  .booking :global(.cart .total td) {
    font-weight: 600;
    border-top: 1px solid var(--border);
    padding-top: 0.4rem;
  }
  .nav-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    margin-top: 1rem;
  }
  .steps {
    color: var(--ink-muted);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .error-summary,
  .notice-box {
    background: #fbeaea;
    color: var(--error);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    margin: 0 0 1rem;
  }
  .notice-box {
    background: var(--pale-gold);
    color: var(--ink);
  }
  .booking :global(.waiver-text) {
    margin-bottom: 1.5rem;
  }
  .after {
    margin-top: 2rem;
  }
</style>
