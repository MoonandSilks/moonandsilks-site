---
import Base from '../layouts/Base.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
---

<Base title="Book a class" description="Book an aerial silk class with Moon and Silks Circus Co. Class times, ages and prices in one place.">
  <section class="section">
    <div class="wrap">
      <h1>Book a class</h1>
      <p class="lede"><span data-placeholder="true">[Class times, ages, and prices will go here.]</span></p>
      <BookingEmbed />
      <p class="muted">Questions before you book? <a href="/contact">Get in touch</a>.</p>
    </div>
  </section>
</Base>
