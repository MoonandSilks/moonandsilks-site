---
import Base from '../layouts/Base.astro';

const classes = [
  { title: '[placeholder: class name]', text: '[placeholder: one line about this class and who it suits.]' },
  { title: '[placeholder: class name]', text: '[placeholder: one line about this class and who it suits.]' },
  { title: '[placeholder: class name]', text: '[placeholder: one line about this class and who it suits.]' },
];
---

<Base title="Home" description="Aerial silk classes for children through to adults with Moon and Silks Circus Co. See class times and book online.">
  <section class="hero">
    <div class="wrap hero-inner">
      <img
        class="hero-logo"
        src="/logo-640.webp"
        srcset="/logo-640.webp 528w, /logo-1024.webp 845w"
        sizes="(min-width: 768px) 340px, 70vw"
        width="528"
        height="640"
        alt=""
        fetchpriority="high"
      />
      <div class="hero-copy">
        <h1>Aerial silk classes.</h1>
        <p class="lede">
          <span data-placeholder="true">[One sentence about who the classes are for, and where.]</span>
        </p>
        <p><a class="btn" href="/book">Book a class</a></p>
      </div>
    </div>
  </section>

  <section class="section section--blue" aria-labelledby="classes-heading">
    <div class="wrap">
      <h2 id="classes-heading">Classes</h2>
      <ul class="cards">
        {
          classes.map((c) => (
            <li class="card">
              <h3>
                <span data-placeholder="true">{c.title}</span>
              </h3>
              <p>
                <span data-placeholder="true">{c.text}</span>
              </p>
              <a href="/book">
                Book this class<span class="visually-hidden">: {c.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/about">About your instructor</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .hero-inner {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
  }
  .hero-logo {
    width: min(70vw, 340px);
    height: auto;
  }
  .hero-copy p {
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .hero-inner {
      grid-template-columns: auto 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
      gap: 3rem;
    }
    .hero-copy p {
      margin-inline: 0;
    }
  }
  .cards {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .card p {
    flex: 1;
  }
  .card a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  .more {
    margin: 1.5rem 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
