---
import { site } from '../site';
interface Props {
  current: string;
}
const { current } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{site.name}</p>
      <p>{site.location.value}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="contact">
      {
        site.socials.map((s) => (
          <li>
            <a href={s.href} data-placeholder={s.placeholder ? 'true' : undefined}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap">
    <p class="copy">&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--pale-gold);
    color: var(--ink-muted);
    border-top: 1px solid var(--border);
    padding-block: 2rem 1rem;
    margin-top: 0;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  .name {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  a {
    color: var(--ink-muted);
  }
  a:hover {
    color: var(--ink);
  }
  a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  .copy {
    font-size: 0.9rem;
    margin: 1rem 0 0;
  }
</style>
