---
// Swap booking tools by setting PUBLIC_BOOKING_EMBED_URL (see README). Unset = placeholder.
import { site } from '../site';
const url = (import.meta.env.PUBLIC_BOOKING_EMBED_URL ?? '').trim();
---

<section id="booking-embed" class="booking" aria-labelledby="booking-heading">
  <h2 id="booking-heading" class="visually-hidden">Booking</h2>
  {
    url ? (
      <iframe src={url} title="Book a class" loading="lazy" allow="payment" />
    ) : (
      <div class="placeholder" data-placeholder="true">
        <p class="big">Booking will sit here once a tool is chosen.</p>
        <p>
          In the meantime, send an enquiry through the <a href="/contact">contact page</a> or email{' '}
          <a href={`mailto:${site.email.value}?subject=Class%20booking`}>{site.email.value}</a>.
        </p>
      </div>
    )
  }
</section>

<style>
  .booking {
    margin-block: 1.5rem;
  }
  iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 720px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .placeholder {
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .placeholder p {
    margin-bottom: 0.5rem;
  }
  .big {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
  }
</style>
