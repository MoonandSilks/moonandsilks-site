---
import { site } from '../site';
interface Props {
  current: string;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <img src="/logo-header.webp" width="132" height="160" alt="Moon and Silks Circus Co" />
      <span class="brand-text" aria-hidden="true">Moon and Silks</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[{ 'nav-cta': item.href === '/book' }]}
                aria-current={current === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    // Close when focus leaves the menu (keyboard users tabbing past the last link).
    nav.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !nav.contains(next) && next !== btn) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    background: var(--page);
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 10;
  }
  .site-header::before {
    content: '';
    display: block;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--moon-blue) 0 25%,
      var(--honey-gold) 25% 50%,
      var(--silks-peach) 50% 75%,
      var(--soft-lavender) 75% 100%
    );
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
    padding-block: 0.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    min-height: 44px;
  }
  .brand img {
    height: 56px;
    width: auto;
  }
  .brand-text {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.2rem;
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 600 1rem var(--font-body);
    cursor: pointer;
  }
  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
    transition: transform 0.15s ease;
  }
  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
  }
  .menu-icon::before {
    top: -6px;
  }
  .menu-icon::after {
    top: 6px;
  }
  [aria-expanded='true'] .menu-icon {
    background: transparent;
  }
  [aria-expanded='true'] .menu-icon::before {
    transform: translateY(6px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-icon::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
    border-radius: 999px;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  .nav a[aria-current='page'] {
    color: var(--ink-blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .nav a.nav-cta {
    background: var(--ink-blue);
    color: var(--page);
    padding-inline: 1.1rem;
    font-weight: 600;
  }
  .nav a.nav-cta:hover {
    background: var(--ink-blue-dark);
  }
  .nav a.nav-cta[aria-current='page'] {
    color: var(--page);
  }

  /* Phone: collapsible menu */
  @media (max-width: 767.98px) {
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--page);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 8px 16px rgb(58 53 47 / 0.08);
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      display: grid;
      gap: 0.25rem;
      padding: 0.75rem var(--gutter) 1rem;
    }
    .nav a {
      font-size: 1.1rem;
    }
    .nav a.nav-cta {
      justify-content: center;
      margin-top: 0.5rem;
    }
  }

  /* Wider: inline nav */
  @media (min-width: 768px) {
    .menu-btn {
      display: none;
    }
    .nav ul {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .nav li:has(.nav-cta) {
      order: 10;
      margin-left: 0.5rem;
    }
  }
</style>
